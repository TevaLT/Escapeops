{
  "name": "tevalt/escapeops",
  "description": "EscapeOps : réservation et exploitation d'un escape game (BTS SIO SLAM, Slim 4 + Medoo)",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-pdo_mysql": "*",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "catfan/medoo": "^2.6",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "db:reset": "php bin/db-reset.php",
    "test": [
      "php tests/http-input.php",
      "php tests/slot-availability.php",
      "php tests/auth-roles.php"
    ]
  }
}
